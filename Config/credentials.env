# ================================
# BOT CONFIGURATION
# ================================

# Discord Bot Credentials
TOKEN=DISCORD_BOT_TOKEN_HERE
CLIENT_ID=DISCORD_BOT_CLIENT_ID_HERE
GUILD_ID=SERVER_ID_HERE
DISCORD_OAUTH_CLIENT_SECRET=DISCORD_OAUTH_CLIENT_SECRET_HERE
DISCORD_OAUTH_REDIRECT_URI=DISCORD_OAUTH_REDIRECT_URI_HERE

# Admin Panel
ENABLE_ADMIN_PANEL=true

# ================================
# DATABASE CONFIGURATION
# ================================

# MySQL Database Connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root # Change this to your MySQL username
MYSQL_PASSWORD=password # Change this to your MySQL password
MYSQL_DATABASE=Sentinel # Change this to your MySQL database name
MYSQLDUMP_PATH=link-to-mysqldump # Optional: Specify path to mysqldump for backups (e.g., /usr/bin/mysqldump)

# MySQL Connection Pool Settings
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=0

# Use MySQL (set to false to fallback to JSON)
USE_MYSQL=true

# ================================
# ADMIN PANEL CONFIGURATION
# ================================

# Admin Panel Server
ADMIN_PORT=3000

# Webhook: Website -> Bot
BOT_WEBHOOK_URL=websitelink.com:3050/webhooks/website
BOT_WEBHOOK_SECRET=a_secure_random_string_for_webhook_validation # CHANGE THIS!
# Change this to a secure random string for validating incoming webhooks
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_WEBHOOK_PORT=3050
BOT_WEBHOOK_TIMEOUT_MS=6000
BOT_WEBHOOK_MAX_DRIFT_MS=300000

# Session Secret (CHANGE THIS!)
SESSION_SECRET=a_secure_random_string_for_session_management # CHANGE THIS!
# Change this to a secure random string for session management in the admin panel
# To generate a new session secret, run:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ================================
# EMAIL CONFIGURATION (SMTP)
# ================================

# Enable Email System
ENABLE_EMAIL=true

# SMTP Server Configuration
# Common providers:
# - Gmail: host=smtp.gmail.com, port=587, secure=false
#   Note: Use App Password, not regular password
# - Outlook: host=smtp-mail.outlook.com, port=587, secure=false
# - Custom: Set host, port, and secure based on your SMTP provider

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=DISCORD_BOT_EMAIL_ADDRESS_HERE
SMTP_PASS=DISCORD_BOT_EMAIL_PASSWORD_HERE

# Admin email address for notifications
ADMIN_EMAIL=ADMIN_EMAIL_ADDRESS_HERE
# ================================
# OPENAI MODERATION (OPTIONAL)
# ================================
# Enable API-backed moderation fallback for AutoMod profanity checks.
# If disabled or key is missing, AutoMod falls back to local blocklist matching only.
ENABLE_OPENAI_MODERATION=true
OPENAI_API_KEY=OPENAI_API_KEY_HERE
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_MODERATION_MIN_SCORE=0.78
OPENAI_MODERATION_TIMEOUT_MS=2500
OPENAI_MODERATION_CACHE_TTL_MS=300000
OPENAI_MODERATION_CACHE_MAX=500

# ================================
# DEVELOPMENT COMMAND WATCHER
# ================================
# Auto-reload slash commands on file changes and re-register with Discord.
# Keep disabled in production.
COMMANDS_WATCH_MODE=false
COMMANDS_WATCH_DEBOUNCE_MS=500
COMMANDS_REGISTER_COOLDOWN_MS=2000

# Verbose diagnostics for Events/_loader.js
EVENTS_LOAD_VERBOSE=false

# Join-to-Create: DM the new owner when ownership auto-transfers.
JTC_NOTIFY_OWNER_TRANSFER=true