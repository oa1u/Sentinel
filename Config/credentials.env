# ================================
# BOT CONFIGURATION
# ================================

# Discord Bot Credentials
TOKEN=DISCORD_BOT_TOKEN_HERE
CLIENT_ID=DISCORD_CLIENT_ID_HERE
GUILD_ID=DISCORD_GUILD_ID_HERE
DISCORD_OAUTH_CLIENT_SECRET=DISCORD_OAUTH_CLIENT_SECRET_HERE
DISCORD_OAUTH_REDIRECT_URI=DISCORD_OAUTH_REDIRECT_URI_HERE

# Admin Panel
ENABLE_ADMIN_PANEL=true

# ================================
# DATABASE CONFIGURATION
# ================================

# MySQL Database Connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=MYSQL_USER_HERE # Change this to your MySQL username
MYSQL_PASSWORD=MYSQL_PASSWORD_HERE # Change this to your MySQL password
MYSQL_DATABASE=Sentinel # Change this to your MySQL database name

# MySQL Connection Pool Settings
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=0

# Use MySQL (set to false to fallback to JSON)
USE_MYSQL=true

# ================================
# ADMIN PANEL CONFIGURATION
# ================================

# Admin Panel Server
ADMIN_PORT=3000

# Session Secret (CHANGE THIS!)
SESSION_SECRET=SESSION_SECRET_HERE # Change this to a secure random string for session management in the admin panel
# To generate a new session secret, run:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ================================
# EMAIL CONFIGURATION (SMTP)
# ================================

# Enable Email System
ENABLE_EMAIL=true

# SMTP Server Configuration
# Common providers:
# - Gmail: host=smtp.gmail.com, port=587, secure=false
#   Note: Use App Password, not regular password
# - Outlook: host=smtp-mail.outlook.com, port=587, secure=false
# - Custom: Set host, port, and secure based on your SMTP provider

SMTP_HOST=SMTP_HOST_HERE
SMTP_PORT=SMTP_PORT_HERE
SMTP_SECURE=false
SMTP_USER=SMTP_EMAIL_HERE
SMTP_PASS=SMTP_PASSWORD_HERE

# Admin email address for notifications
ADMIN_EMAIL=MAIN_OWNER_EMAIL_HERE